<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/undercromo_gray"
    android:padding="12dp">

    <EditText
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar en wishlist"
        android:background="@drawable/inputs_style"
        android:paddingVertical="10dp"
        android:paddingStart="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/undercromo_gray_placeholder"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:inputType="text" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_wishlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/undercromo_gray_inputs"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/total_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total: $0"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_go_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ir al carrito"
            android:textColor="@color/white"
            android:background="@drawable/category_button"
            android:paddingVertical="10dp"
            android:paddingHorizontal="16dp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
